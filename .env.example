# String de conexão do Postgres (obrigatória) — onde fica guardado todo o
# estado (projetos, fases, tarefas, webhooks, notas de reunião).
DATABASE_URL=postgres://user:senha@host:5432/nome_do_banco

# Chave opcional pra proteger a API. Se deixar em branco, os endpoints ficam
# abertos sem autenticação (ok pra teste, não recomendado em produção aberta
# pra internet).
API_KEY=
