DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=4000

# Chave que só você (dono da plataforma) usa pra criar/remover clientes
# (POST/DELETE /api/tenants). Cada cliente usa sua própria chave (gerada na
# criação), não essa.
SUPER_ADMIN_KEY=

# Servidor Evolution API onde cada cliente novo ganha sua própria instância de
# WhatsApp (criada automaticamente ao cadastrar o cliente).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Opcional: URL do webhook do agente de IA no n8n pra onde toda instância nova
# aponta. Sem isso, usa o valor padrão já configurado em evolution.js.
EVOLUTION_WEBHOOK_URL=

# OAuth do Google (Google Cloud Console → Credenciais → ID do cliente OAuth,
# tipo "Aplicativo da Web") — cada cliente conecta a própria conta pra
# importar notas do Meet direto, sem depender do fluxo no n8n.
# URI de redirecionamento autorizado deve ser exatamente GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agent-api.nexusdevhub.com/api/google/callback
